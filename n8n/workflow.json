    {
      "parameters": {
        "functionCode": "const b = $json.body || {};\n\nconst commits = Array.isArray(b.commits) ? b.commits : [];\nconst commitsText = commits.length\n  ? commits.map(c => `- ${c}`).join('\\n')\n  : '- (no commits found)';\n\nreturn [{\n  json: {\n    text:\n`Push complete\nUser: ${b.user}\nRepo: ${b.repo_slug}\nBranch: ${b.branch}\nRemote: ${b.remote_name}\n\nCommits pushed: ${b.commit_count}\nFiles changed: ${b.files_changed}\n\n${commitsText}`\n  }\n}];\n"
      },
