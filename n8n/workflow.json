        "responses": {
          "values": [
            {
              "content": "=You are a senior software engineer.\n\nAnalyze the following git diff and identify all logical changes.\nFor EACH logical change, generate ONE Git commit message following\nthe Conventional Commits specification.\n\nRules:\n- Use the correct type: feat, fix, refactor, chore, docs, test, perf, ci, build\n- Use imperative, present tense\n- Max 72 characters per message\n- No emojis\n- No markdown\n- No explanations\n- No numbering\n-Generate commit messages for all logical changes.\nIf more than 5 messages are possible, return ONLY the 5 most important ones.\n\nReturn ONLY valid JSON in this exact format:\n{\n  \"messages\": [\n    \"<type>: <description>\",\n    \"<type>: <description>\"\n  ]\n}\n\nGit diff:\n{{$json.body.diff}}\n"
            },
            {
              "role": "system",
              "content": "You are an expert software engineer.\nGenerate concise, professional Git commit messages.\n"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
